{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write resources/js resources/css eslint.config.js package.json tsconfig.json vite.config.js vitest.config.ts",
        "format:check": "prettier --check resources/js resources/css eslint.config.js package.json tsconfig.json vite.config.js vitest.config.ts",
        "lint": "eslint .",
        "test:unit": "vitest run",
        "type-check": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^22.20.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/test-utils": "^2.4.11",
        "concurrently": "^10.0.3",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.10.0",
        "globals": "^17.8.0",
        "jsdom": "^29.1.1",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.0.0",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.8"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.6.1",
        "@primeuix/themes": "^2.0.3",
        "primeicons": "^8.0.0",
        "primevue": "^4.5.5",
        "tailwindcss-primeui": "^0.6.1",
        "vue": "^3.5.40"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
